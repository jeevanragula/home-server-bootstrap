# Home Server configuration
# Copy this file to .env and set your own values.
# .env is ignored by Git and must NEVER be committed.

DATA_ROOT=/srv/docker
TZ=Asia/Kolkata

# Offline backup SSD mount + destination
BACKUP_MOUNT=/mnt/home-server-backup
BACKUP_ROOT=/mnt/home-server-backup/homeserver

# Immich / PostgreSQL
IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=CHANGE_ME_TO_YOUR_OWN_LONG_PASSWORD
IMMICH_DB_NAME=immich

# Immich release. Pin to a tested release rather than floating on :release.
IMMICH_VERSION=v3.2.2
